rules_version = '2';

/*
 * AfterBI: security rules. The GitHub Action publishes this file whenever it
 * changes (or paste it into Firebase console → Firestore Database → Rules).
 *
 * Two kinds of people inside an organisation:
 *   insiders (super admin, admin, staff, finance, operations, warehouse)
 *     read every account. The super admin oversees everything.
 *   partners (distributors and sales reps) read only their own accounts:
 *              a distributor its own, a rep the ones assigned to it.
 *
 * Firestore allows a request if ANY matching rule does, so every block below
 * only ever adds permission to the catch-all.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    /* helpers */

    function signedIn() {
      return request.auth != null;
    }

    /* The signed-in user's own profile. One billed read, cached per request.
       Fields are read with .get() and a default: a missing field in a rule is
       an error, and an error denies. */
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeProfile() {
      return signedIn() && profile().get('active', true) != false;
    }

    function role() {
      return profile().get('role', '');
    }

    /* On this organisation's books, whatever its subscription says. */
    function belongs(orgId) {
      return activeProfile() && profile().get('orgId', '') == orgId;
    }

    /* The organisation exists and the platform owner has not suspended it. */
    function tenantOpen(orgId) {
      return exists(/databases/$(database)/documents/orgs/$(orgId))
        && get(/databases/$(database)/documents/orgs/$(orgId)).data.get('status', 'active') != 'suspended';
    }

    /* A working member. */
    function member(orgId) {
      return belongs(orgId) && tenantOpen(orgId);
    }

    function hasRole(orgId, roles) {
      return member(orgId) && role() in roles;
    }

    function admin(orgId) {
      return hasRole(orgId, ['super_admin', 'admin']);
    }

    /* Runs the platform. Belongs to no organisation. */
    function owner() {
      return activeProfile() && role() == 'owner';
    }

    /* Inside the business: every account, every record. */
    function insider(orgId) {
      return hasRole(orgId, [
        'super_admin', 'admin', 'staff', 'finance_manager', 'operations_manager', 'warehouse_manager'
      ]);
    }

    function isPartnerRole(orgId) {
      return hasRole(orgId, ['distributor', 'sales_rep']);
    }

    /* The accounts a partner works on: the same list as partnerScope() in the app. */
    function ownAccount() {
      return profile().get('distributorId', '') is string && profile().get('distributorId', '') != ''
        ? [profile().get('distributorId', '')]
        : [];
    }

    function accounts() {
      return role() == 'sales_rep'
        ? profile().get('distributorIds', []).concat(ownAccount())
        : ownAccount();
    }

    /* A distributor or rep, on one of its own accounts. */
    function partnerOf(orgId, distributorId) {
      return isPartnerRole(orgId) && distributorId in accounts();
    }

    /* A write naming an account: insiders any, partners only their own. */
    function mayUseAccount(distributorId) {
      return !(role() in ['distributor', 'sales_rep']) || distributorId in accounts();
    }

    /* The order value from which a signature is needed. Zero: never. */
    function threshold(orgId) {
      return get(/databases/$(database)/documents/orgs/$(orgId)/settings/org).data.get('approvalThreshold', 0);
    }

    /* Straight to approved: under the threshold, or raised by the super admin. */
    function mayApproveAtOnce(orgId, total) {
      return role() == 'super_admin' || threshold(orgId) == 0 || total < threshold(orgId);
    }

    /* Nothing in this app is hard-deleted by a client. */
    function immutable() {
      return false;
    }

    function monthPrefix() {
      return string(request.time.year())
        + (request.time.month() < 10 ? '-0' : '-')
        + string(request.time.month());
    }

    function inCurrentMonth(isoDate) {
      return isoDate is string && isoDate.size() >= 7 && isoDate[0:7] == monthPrefix();
    }

    /* users */
    /*
     * A root collection: signing in gives a uid and nothing else, and this
     * document says which organisation the session belongs to. The platform
     * owner's own document is created by hand in the console.
     */
    match /users/{uid} {
      /* Yourself, the owner, insiders their whole organisation: and a
         partner only the people who can sign an order. */
      allow get: if signedIn() && (
        request.auth.uid == uid
        || owner()
        || (
          activeProfile()
          && profile().get('orgId', '') == resource.data.get('orgId', 'none')
          && (
            role() in ['super_admin', 'admin', 'staff', 'finance_manager', 'operations_manager', 'warehouse_manager']
            || resource.data.get('role', '') in ['super_admin', 'admin', 'staff', 'finance_manager', 'operations_manager']
          )
        )
      );

      /* Filtered to the caller's organisation and capped; for a partner, to signatories. */
      allow list: if signedIn() && (
        owner()
        || (
          activeProfile()
          && request.query.limit <= 500
          && resource.data.orgId == profile().get('orgId', '')
          && (
            role() in ['super_admin', 'admin', 'staff', 'finance_manager', 'operations_manager', 'warehouse_manager']
            || resource.data.role in ['super_admin', 'admin', 'staff', 'finance_manager', 'operations_manager']
          )
        )
      );

      /*
       * Accounts are made in the app (`src/lib/accounts.ts`). The owner may add
       * anyone to any organisation; an administrator only to their own, and
       * only a super admin may make another super admin. Nobody makes an owner.
       */
      allow create: if signedIn()
        && request.resource.data.role != 'owner'
        && request.resource.data.orgId is string
        && request.resource.data.active == true
        && (
          owner()
          || (
            admin(request.resource.data.orgId)
            && request.resource.data.role in [
              'super_admin', 'admin', 'staff', 'sales_rep', 'distributor',
              'warehouse_manager', 'finance_manager', 'operations_manager'
            ]
            && (request.resource.data.role != 'super_admin' || role() == 'super_admin')
          )
        );

      /* Your own name, phone, title and photograph: never your role, organisation, accounts or active flag. */
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['firstName', 'lastName', 'title', 'phone', 'photoURL', 'updatedAt', 'lastSeenAt']);

      /* An administrator, on anybody in their own organisation except themselves.
         Only a super admin may change a super admin, or make one. */
      allow update: if admin(resource.data.get('orgId', ''))
        && request.auth.uid != uid
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.role != 'owner'
        && (
          role() == 'super_admin'
          || (resource.data.role != 'super_admin' && request.resource.data.role != 'super_admin')
        );

      /* The owner, on anybody but another owner. */
      allow update: if owner()
        && resource.data.role != 'owner'
        && request.resource.data.role != 'owner';

      /* Suspended, never deleted: every record names the uid that made it. */
      allow delete: if immutable();
    }

    /*
      THE ONE PUBLIC DOCUMENT IN THIS DATABASE.

      `site/home` holds the landing page's cover images and nothing else: no
      tenant's data, no figures, no names. It is read by anybody at all,
      including a visitor who has never signed in, because that is precisely
      what a shop window is for — and it is written only by the platform owner,
      from Platform → Website.

      `allow read` rather than `get` alone: the page reads the single document,
      but a listing of a one-document collection discloses nothing either, and
      refusing it would only produce a confusing error in the console.

      Every other collection stays behind the tenant rules below. If a second
      public document is ever wanted, it goes in THIS collection rather than
      loosening one of those — one public place is auditable, two is a habit.
    */
    match /site/{docId} {
      allow read: if true;
      allow write: if owner();
    }

    /* the tenant record */

    match /orgs/{orgId} {
      allow get: if owner() || belongs(orgId);
      allow list: if owner();
      allow create, update, delete: if owner();
    }

    /* everything an org owns */

    /* Insiders read everything. Partners get only what is granted below. */
    match /orgs/{orgId}/{document=**} {
      allow read: if owner() || insider(orgId);
    }

    /* Shared with every member: the organisation's details, catalogue, depots. */
    match /orgs/{orgId}/settings/{docId} {
      allow read: if member(orgId);
      allow write: if owner() || admin(orgId);
    }

    match /orgs/{orgId}/products/{productId} {
      allow read: if member(orgId);
      allow create, update: if admin(orgId);
      allow delete: if immutable();
    }

    match /orgs/{orgId}/warehouses/{warehouseId} {
      allow read: if member(orgId);
      allow write: if hasRole(orgId, ['super_admin', 'admin', 'operations_manager']);
    }

    /* Document numbers (PO-2026-0041), read and bumped inside a transaction. */
    match /orgs/{orgId}/counters/{counterId} {
      allow read, write: if member(orgId);
    }

    match /orgs/{orgId}/distributors/{distributorId} {
      allow get: if partnerOf(orgId, distributorId);
      allow create: if hasRole(orgId, ['super_admin', 'admin', 'staff']);
      allow update: if admin(orgId);
      /* Contact details, yes; commercial terms, no. */
      allow update: if (hasRole(orgId, ['staff']) || partnerOf(orgId, distributorId))
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['category', 'creditLimit', 'paymentTermsDays', 'status', 'userId']);
      allow delete: if immutable();
    }

    match /orgs/{orgId}/orders/{orderId} {
      allow get: if partnerOf(orgId, resource.data.distributorId);
      allow list: if partnerOf(orgId, resource.data.distributorId) && request.query.limit <= 500;

      /* Nobody signs their own order, and nothing over the threshold skips a signature. */
      allow create: if hasRole(orgId, ['super_admin', 'admin', 'staff', 'sales_rep', 'distributor'])
        && mayUseAccount(request.resource.data.distributorId)
        && request.resource.data.createdBy == request.auth.uid
        && !(request.auth.uid in request.resource.data.get('approvers', []))
        && (
          request.resource.data.status in ['draft', 'pending_approval']
          || (
            request.resource.data.status == 'approved'
            && request.resource.data.get('approvers', []).size() == 0
            && mayApproveAtOnce(orgId, request.resource.data.total)
          )
        )
        && request.resource.data.total >= 0;

      /* A draft: the office, its author, or a partner on its own account.
         Mirrors `src/lib/amend.ts`. */
      allow update: if resource.data.status == 'draft'
        && (
          hasRole(orgId, ['super_admin', 'admin', 'staff'])
          || resource.data.createdBy == request.auth.uid
          || partnerOf(orgId, resource.data.distributorId)
        )
        && mayUseAccount(request.resource.data.distributorId)
        && !(request.auth.uid in request.resource.data.get('approvers', []))
        && (
          request.resource.data.status != 'approved'
          || (
            request.resource.data.get('approvers', []).size() == 0
            && mayApproveAtOnce(orgId, request.resource.data.total)
          )
        );

      /* Signing: a named approver may decide, but not change what was ordered. */
      allow update: if resource.data.status == 'pending_approval'
        && request.auth.uid in resource.data.approvers
        && request.resource.data.total == resource.data.total
        && request.resource.data.lines == resource.data.lines
        && request.resource.data.distributorId == resource.data.distributorId;

      /* Recalling: the author takes it back to draft before anyone has signed. */
      allow update: if resource.data.status == 'pending_approval'
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'draft'
        && request.resource.data.approvals.size() == 0
        && request.resource.data.total == resource.data.total
        && request.resource.data.lines == resource.data.lines;

      /* A super admin or admin can decide any pending order. */
      allow update: if resource.data.status == 'pending_approval' && admin(orgId);

      allow update: if resource.data.status == 'approved'
        && hasRole(orgId, ['super_admin', 'admin', 'warehouse_manager', 'operations_manager'])
        && request.resource.data.status == 'fulfilled'
        && request.resource.data.total == resource.data.total
        && request.resource.data.lines == resource.data.lines;
      allow update: if resource.data.status in ['approved', 'rejected', 'cancelled']
        && admin(orgId);
      allow update: if resource.data.status == 'fulfilled'
        && admin(orgId)
        && request.resource.data.lines == resource.data.lines
        && request.resource.data.total == resource.data.total;
      allow delete: if immutable();
    }

    match /orgs/{orgId}/stock/{positionId} {
      allow write: if hasRole(orgId, [
        'super_admin', 'admin', 'staff', 'warehouse_manager', 'operations_manager'
      ]);
    }

    /* Append-only: a mistake is corrected with an opposite movement. */
    match /orgs/{orgId}/stockMovements/{movementId} {
      allow create: if hasRole(orgId, [
        'super_admin', 'admin', 'staff', 'warehouse_manager', 'operations_manager'
      ]);
      allow update, delete: if immutable();
    }

    match /orgs/{orgId}/sales/{saleId} {
      allow read: if partnerOf(orgId, resource.data.distributorId);
      allow create: if hasRole(orgId, ['super_admin', 'admin', 'staff', 'sales_rep', 'distributor'])
        && mayUseAccount(request.resource.data.distributorId)
        && request.resource.data.capturedBy == request.auth.uid
        && request.resource.data.quantity > 0;
      allow update: if admin(orgId)
        || (
          resource.data.capturedBy == request.auth.uid
          && inCurrentMonth(resource.data.saleDate)
          && request.resource.data.distributorId == resource.data.distributorId
        );
      allow delete: if admin(orgId) || resource.data.capturedBy == request.auth.uid;
    }

    /* A rep's own pipeline. */
    match /orgs/{orgId}/leads/{leadId} {
      allow read: if hasRole(orgId, ['sales_rep']) && resource.data.ownerId == request.auth.uid;
      allow create: if hasRole(orgId, ['super_admin', 'admin', 'staff', 'sales_rep'])
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if admin(orgId) || resource.data.ownerId == request.auth.uid;
      allow delete: if admin(orgId);
    }

    match /orgs/{orgId}/invoices/{invoiceId} {
      allow read: if partnerOf(orgId, resource.data.distributorId);
      allow create: if hasRole(orgId, ['super_admin', 'admin', 'finance_manager'])
        && request.resource.data.amountPaid == 0;
      allow update: if hasRole(orgId, ['super_admin', 'admin', 'finance_manager'])
        && request.resource.data.total >= resource.data.amountPaid;
      allow delete: if immutable();
    }

    /* Append-only, like the stock ledger. */
    match /orgs/{orgId}/payments/{paymentId} {
      allow read: if partnerOf(orgId, resource.data.distributorId);
      allow create: if hasRole(orgId, ['super_admin', 'admin', 'finance_manager'])
        && request.resource.data.recordedBy == request.auth.uid
        && request.resource.data.amount > 0;
      allow update, delete: if immutable();
    }

    match /orgs/{orgId}/returns/{returnId} {
      allow read: if partnerOf(orgId, resource.data.distributorId);
      allow create: if member(orgId)
        && mayUseAccount(request.resource.data.distributorId)
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'requested'
        && request.resource.data.quantity > 0;
      allow update: if hasRole(orgId, [
          'super_admin', 'admin', 'staff', 'warehouse_manager', 'operations_manager'
        ])
        || (
          resource.data.status == 'requested'
          && resource.data.requestedBy == request.auth.uid
          && request.resource.data.status == 'requested'
          && request.resource.data.distributorId == resource.data.distributorId
        );
      allow delete: if immutable();
    }

    /* A partner sees its own target and its accounts'. */
    match /orgs/{orgId}/targets/{targetId} {
      allow read: if isPartnerRole(orgId)
        && (resource.data.ownerId == request.auth.uid || resource.data.ownerId in accounts());
      allow write: if admin(orgId);
    }

    /* Deny everything else, on purpose. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
