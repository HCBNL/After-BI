rules_version = '2';

/*
 * AfterBI: security rules. The GitHub Action publishes this file whenever it
 * changes (or paste it into Firebase console → Firestore Database → Rules).
 *
 * Two kinds of people inside an organisation:
 *   insiders (super admin, admin, staff, finance, operations, warehouse)
 *     read every account. The super admin oversees everything.
 *   partners (distributors and sales reps) read only their own accounts:
 *              a distributor its own, a rep the ones assigned to it.
 *
 * Firestore allows a request if ANY matching rule does, so every block below
 * only ever adds permission to the catch-all.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    /* helpers */

    function signedIn() {
      return request.auth != null;
    }

    /* The signed-in user's own profile. One billed read, cached per request.
       Fields are read with .get() and a default: a missing field in a rule is
       an error, and an error denies. */
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeProfile() {
      return signedIn() && profile().get('active', true) != false;
    }

    function role() {
      return profile().get('role', '');
    }

    /* On this organisation's books, whatever its subscription says. */
    function belongs(orgId) {
      return activeProfile() && profile().get('orgId', '') == orgId;
    }

    /* The organisation exists and the platform owner has not suspended it. */
    function tenantOpen(orgId) {
      return exists(/databases/$(database)/documents/orgs/$(orgId))
        && get(/databases/$(database)/documents/orgs/$(orgId)).data.get('status', 'active') != 'suspended';
    }

    /* A working member. */
    function member(orgId) {
      return belongs(orgId) && tenantOpen(orgId);
    }

    function hasRole(orgId, roles) {
      return member(orgId) && role() in roles;
    }

    function admin(orgId) {
      return hasRole(orgId, ['super_admin', 'admin']);
    }

    /* Runs the platform. Belongs to no organisation. */
    function owner() {
      return activeProfile() && role() == 'owner';
    }

    /* Inside the business: every account, every record. */
    function insider(orgId) {
      return hasRole(orgId, [
        'super_admin', 'admin', 'staff', 'finance_manager', 'operations_manager', 'warehouse_manager'
      ]);
    }

    function isPartnerRole(orgId) {
      return hasRole(orgId, ['distributor', 'sales_rep']);
    }

    /* The accounts a partner works on: the same list as partnerScope() in the app. */
    function ownAccount() {
      return profile().get('distributorId', '') is string && profile().get('distributorId', '') != ''
        ? [profile().get('distributorId', '')]
        : [];
    }

    function accounts() {
      return role() == 'sales_rep'
        ? profile().get('distributorIds', []).concat(ownAccount())
        : ownAccount();
    }

    /* A distributor or rep, on one of its own accounts. */
    function partnerOf(orgId, distributorId) {
      return isPartnerRole(orgId) && distributorId in accounts();
    }

    /* A write naming an account: insiders any, partners only their own. */
    function mayUseAccount(distributorId) {
      return !(role() in ['distributor', 'sales_rep']) || distributorId in accounts();
    }

    /* The order value from which a signature is needed. Zero: never. */
    function threshold(orgId) {
      return get(/databases/$(database)/documents/orgs/$(orgId)/settings/org).data.get('approvalThreshold', 0);
    }

    /* Straight to approved: under the threshold, or raised by the super admin. */
    function mayApproveAtOnce(orgId, total) {
      return role() == 'super_admin' || threshold(orgId) == 0 || total < threshold(orgId);
    }

    /* Nothing in this app is hard-deleted by a client. */
    function immutable() {
      return false;
    }

    function monthPrefix() {
      return string(request.time.year())
        + (request.time.month() < 10 ? '-0' : '-')
        + string(request.time.month());
    }

    function inCurrentMonth(isoDate) {
      return isoDate is string && isoDate.size() >= 7 && isoDate[0:7] == monthPrefix();
    }

    /* users */
    /*
     * A root collection: signing in gives a uid and nothing else, and this
     * document says which organisation the session belongs to. The platform
     * owner's own document is created by hand in the console.
     */
    match /users/{uid} {
      /* Yourself, the owner, insiders their whole organisation: and a
         partner only the people who can sign an order. */
      allow get: if signedIn() && (
        request.auth.uid == uid
        || owner()
        || (
          activeProfile()
          && profile().get('orgId', '') == resource.data.get('orgId', 'none')
          && (
            role() in ['super_admin', 'admin', 'staff', 'finance_manager', 'operations_manager', 'warehouse_manager', 'hr']
            || resource.data.get('role', '') in ['super_admin', 'admin', 'staff', 'finance_manager', 'operations_manager']
          )
        )
      );

      /* Filtered to the caller's organisation and capped; for a partner, to signatories. */
      allow list: if signedIn() && (
        owner()
        || (
          activeProfile()
          && request.query.limit <= 500
          && resource.data.orgId == profile().get('orgId', '')
          && (
            role() in ['super_admin', 'admin', 'staff', 'finance_manager', 'operations_manager', 'warehouse_manager', 'hr']
            || resource.data.role in ['super_admin', 'admin', 'staff', 'finance_manager', 'operations_manager']
          )
        )
      );

      /*
       * Accounts are made in the app (`src/lib/accounts.ts`). The owner may add
       * anyone to any organisation; an administrator only to their own, and
       * only a super admin may make another super admin. Nobody makes an owner.
       */
      allow create: if signedIn()
        && request.resource.data.role != 'owner'
        && request.resource.data.active == true
        && (
          /* AfterBI's own staff: made by the owner, belonging to no organisation. */
          (owner() && request.resource.data.role == 'agent' && !('orgId' in request.resource.data))
          || (owner() && request.resource.data.role != 'agent' && request.resource.data.orgId is string)
          || (
            request.resource.data.orgId is string
            && admin(request.resource.data.orgId)
            && request.resource.data.role in [
              'super_admin', 'admin', 'staff', 'sales_rep', 'distributor',
              'warehouse_manager', 'finance_manager', 'operations_manager', 'hr'
            ]
            && (request.resource.data.role != 'super_admin' || role() == 'super_admin')
          )
        );

      /* Your own name, phone, title and photograph: never your role, organisation, accounts or active flag. */
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['firstName', 'lastName', 'title', 'phone', 'photoURL', 'position', 'location', 'updatedAt', 'lastSeenAt']);

      /* An administrator, on anybody in their own organisation except themselves.
         Only a super admin may change a super admin, or make one. */
      allow update: if admin(resource.data.get('orgId', ''))
        && request.auth.uid != uid
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.role != 'owner'
        && (
          role() == 'super_admin'
          || (resource.data.role != 'super_admin' && request.resource.data.role != 'super_admin')
        );

      /* The owner, on anybody but another owner. */
      allow update: if owner()
        && resource.data.role != 'owner'
        && request.resource.data.role != 'owner';

      /* Suspended, never deleted: every record names the uid that made it. */
      allow delete: if immutable();
    }

    /*
      THE ONE PUBLIC DOCUMENT IN THIS DATABASE.

      `site/home` holds the landing page's cover images and nothing else: no
      tenant's data, no figures, no names. It is read by anybody at all,
      including a visitor who has never signed in, because that is precisely
      what a shop window is for, and it is written only by the platform owner,
      from Platform → Website.

      `allow read` rather than `get` alone: the page reads the single document,
      but a listing of a one-document collection discloses nothing either, and
      refusing it would only produce a confusing error in the console.

      Every other collection stays behind the tenant rules below. If a second
      public document is ever wanted, it goes in THIS collection rather than
      loosening one of those, one public place is auditable, two is a habit.
    */
    match /site/{docId} {
      allow read: if true;
      allow write: if owner();
    }

    /*
      The blog. One document per article, the slug as its id.

      Anybody may read a PUBLISHED article; a draft is refused to everybody
      but the platform owner, so an unfinished article cannot be read by
      guessing its address. The public site asks for published articles only
      (a query on status), which these rules allow; a listing that might
      include a draft is refused as a whole.
    */
    /* Proposals to prospects: the owner sees all; an AfterBI staff member only their own. */
    match /proposals/{proposalId} {
      allow read, write: if owner();
      allow read: if activeProfile() && role() == 'agent' && resource.data.get('createdBy', '') == request.auth.uid;
      allow create: if activeProfile() && role() == 'agent' && request.resource.data.get('createdBy', '') == request.auth.uid;
      allow update: if activeProfile() && role() == 'agent'
        && resource.data.get('createdBy', '') == request.auth.uid
        && request.resource.data.get('createdBy', '') == request.auth.uid;
      allow delete: if activeProfile() && role() == 'agent' && resource.data.get('createdBy', '') == request.auth.uid;
    }

    /*
      The public check behind an AfterBI staff ID card's QR code: name,
      position, location and whether they are current. Nothing else. Written by
      the owner; a staff member may refresh only their own position and location.
    */
    /* An organisation's staff ID card check (src/lib/idCards.ts). Public read,
       so the QR on a card works for anyone; written only by the holder, for
       their own organisation; suspended by that organisation's admins. */
    match /idCards/{uid} {
      allow read: if true;
      allow create, update: if activeProfile()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.orgId == profile().get('orgId', '')
        && request.resource.data.active == true
        && request.resource.data.keys().hasOnly(['uid', 'orgId', 'name', 'position', 'company', 'logo', 'phone', 'email', 'website', 'location', 'staffNo', 'active', 'updatedAt']);
      allow update: if admin(resource.data.orgId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'updatedAt']);
      allow delete: if request.auth.uid == uid || admin(resource.data.orgId);
    }

    match /staffCards/{staffNo} {
      allow read: if true;
      allow write: if owner();
      allow update: if activeProfile() && role() == 'agent'
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['position', 'location', 'updatedAt']);
    }

    /* Bank profiles: names and logos the platform owner keeps, so an
       organisation picks its bank and types only the account number. */
    match /bankProfiles/{bankId} {
      allow read: if activeProfile();
      allow write: if owner();
    }

    match /posts/{slug} {
      allow read: if resource.data.status == 'published' || owner();
      allow write: if owner();
    }

    /*
      A person's own to do list. Theirs alone: not their organisation's, not
      the owner's. It sits under the user rather than under the organisation
      on purpose, because insiders may read everything under orgs/{orgId}, and
      a private list of what somebody means to do next is not company data.
    */
    match /users/{uid}/tasks/{taskId} {
      allow read, write: if activeProfile() && request.auth.uid == uid;
    }

    /* the tenant record */

    match /orgs/{orgId} {
      allow get: if owner() || belongs(orgId);
      allow list: if owner();
      allow create, update, delete: if owner();
    }

    /* everything an org owns */

    /* Insiders read everything. Partners get only what is granted below. */
    match /orgs/{orgId}/{document=**} {
      allow read: if owner() || insider(orgId);
    }

    /* Shared with every member: the organisation's details, catalogue, depots. */
    match /orgs/{orgId}/settings/{docId} {
      allow read: if member(orgId);
      allow write: if owner() || admin(orgId);
    }

    match /orgs/{orgId}/products/{productId} {
      allow read: if member(orgId);
      allow create, update: if admin(orgId);
      allow delete: if immutable();
    }

    match /orgs/{orgId}/warehouses/{warehouseId} {
      allow read: if member(orgId);
      allow write: if hasRole(orgId, ['super_admin', 'admin', 'operations_manager']);
    }

    /* Document numbers (PO-2026-0041), read and bumped inside a transaction. */
    match /orgs/{orgId}/counters/{counterId} {
      allow read, write: if member(orgId);
    }

    match /orgs/{orgId}/distributors/{distributorId} {
      allow get: if partnerOf(orgId, distributorId);
      allow create: if hasRole(orgId, ['super_admin', 'admin', 'staff']);
      allow update: if admin(orgId);
      /* Contact details, yes; commercial terms, no. */
      allow update: if (hasRole(orgId, ['staff']) || partnerOf(orgId, distributorId))
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['category', 'creditLimit', 'paymentTermsDays', 'status', 'userId']);
      allow delete: if immutable();
    }

    match /orgs/{orgId}/orders/{orderId} {
      allow get: if partnerOf(orgId, resource.data.distributorId);
      allow list: if partnerOf(orgId, resource.data.distributorId) && request.query.limit <= 500;

      /* Nobody signs their own order, and nothing over the threshold skips a signature. */
      allow create: if hasRole(orgId, ['super_admin', 'admin', 'staff', 'sales_rep', 'distributor'])
        && mayUseAccount(request.resource.data.distributorId)
        && request.resource.data.createdBy == request.auth.uid
        && !(request.auth.uid in request.resource.data.get('approvers', []))
        && (
          request.resource.data.status in ['draft', 'pending_approval']
          || (
            request.resource.data.status == 'approved'
            && request.resource.data.get('approvers', []).size() == 0
            && mayApproveAtOnce(orgId, request.resource.data.total)
          )
        )
        && request.resource.data.total >= 0;

      /* A draft: the office, its author, or a partner on its own account.
         Mirrors `src/lib/amend.ts`. */
      allow update: if resource.data.status == 'draft'
        && (
          hasRole(orgId, ['super_admin', 'admin', 'staff'])
          || resource.data.createdBy == request.auth.uid
          || partnerOf(orgId, resource.data.distributorId)
        )
        && mayUseAccount(request.resource.data.distributorId)
        && !(request.auth.uid in request.resource.data.get('approvers', []))
        && (
          request.resource.data.status != 'approved'
          || (
            request.resource.data.get('approvers', []).size() == 0
            && mayApproveAtOnce(orgId, request.resource.data.total)
          )
        );

      /* Signing: a named approver may decide, but not change what was ordered. */
      allow update: if resource.data.status == 'pending_approval'
        && request.auth.uid in resource.data.approvers
        && request.resource.data.total == resource.data.total
        && request.resource.data.lines == resource.data.lines
        && request.resource.data.distributorId == resource.data.distributorId;

      /* Recalling: the author takes it back to draft before anyone has signed. */
      allow update: if resource.data.status == 'pending_approval'
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'draft'
        && request.resource.data.approvals.size() == 0
        && request.resource.data.total == resource.data.total
        && request.resource.data.lines == resource.data.lines;

      /* A super admin or admin can decide any pending order. */
      allow update: if resource.data.status == 'pending_approval' && admin(orgId);

      allow update: if resource.data.status == 'approved'
        && hasRole(orgId, ['super_admin', 'admin', 'warehouse_manager', 'operations_manager'])
        && request.resource.data.status == 'fulfilled'
        && request.resource.data.total == resource.data.total
        && request.resource.data.lines == resource.data.lines;
      allow update: if resource.data.status in ['approved', 'rejected', 'cancelled']
        && admin(orgId);
      /* A price adjustment (credit note) recorded on its order. Only the credit
         fields move; what was approved and delivered stays exactly as it was.
         Written with the note itself, see `issueCreditNote`. */
      allow update: if resource.data.status in ['approved', 'fulfilled']
        && hasRole(orgId, ['super_admin', 'admin', 'finance_manager'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['credits', 'creditTotal', 'netTotal', 'updatedAt'])
        && request.resource.data.creditTotal is number
        && request.resource.data.creditTotal >= 0
        && request.resource.data.creditTotal <= resource.data.total
        && request.resource.data.netTotal >= 0;
      /* Fulfilled is final: goods have left. The only write left is giving an
         older order its delivery note number. Reversals go through returns. */
      allow update: if resource.data.status == 'fulfilled'
        && member(orgId)
        && !(role() in ['distributor', 'sales_rep'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveryNumber', 'updatedAt'])
        && resource.data.get('deliveryNumber', '') == '';
      allow delete: if immutable();
    }

    match /orgs/{orgId}/stock/{positionId} {
      allow write: if hasRole(orgId, [
        'super_admin', 'admin', 'staff', 'warehouse_manager', 'operations_manager'
      ]);
    }

    /* Append-only: a mistake is corrected with an opposite movement. */
    match /orgs/{orgId}/stockMovements/{movementId} {
      allow create: if hasRole(orgId, [
        'super_admin', 'admin', 'staff', 'warehouse_manager', 'operations_manager'
      ]);
      allow update, delete: if immutable();
    }

    match /orgs/{orgId}/sales/{saleId} {
      allow read: if partnerOf(orgId, resource.data.distributorId);
      allow create: if hasRole(orgId, ['super_admin', 'admin', 'staff', 'sales_rep', 'distributor'])
        && mayUseAccount(request.resource.data.distributorId)
        && request.resource.data.capturedBy == request.auth.uid
        && request.resource.data.quantity > 0;
      allow update: if admin(orgId)
        || (
          resource.data.capturedBy == request.auth.uid
          && inCurrentMonth(resource.data.saleDate)
          && request.resource.data.distributorId == resource.data.distributorId
        );
      allow delete: if admin(orgId) || resource.data.capturedBy == request.auth.uid;
    }

    /* A rep's own pipeline. */
    /*
      Leads: a name and a trail, until a manager confirms it as a customer.
      Its rep keeps the details and asks for confirmation; only a manager
      confirms, declines or removes. The trail is append only.
    */
    match /orgs/{orgId}/leads/{leadId} {
      allow read: if hasRole(orgId, ['sales_rep']) && resource.data.ownerId == request.auth.uid;
      allow create: if hasRole(orgId, ['super_admin', 'admin', 'staff', 'sales_rep'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'open';
      allow update: if admin(orgId);
      allow update: if resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && resource.data.get('status', 'open') != 'confirmed'
        && request.resource.data.get('status', 'open') in ['open', 'pending']
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['confirmedAt', 'confirmedByName', 'customerId']);
      allow delete: if admin(orgId);

      function leadData() {
        return get(/databases/$(database)/documents/orgs/$(orgId)/leads/$(leadId)).data;
      }

      match /logs/{logId} {
        allow read: if hasRole(orgId, ['sales_rep']) && leadData().ownerId == request.auth.uid;
        allow create: if request.resource.data.by == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && request.resource.data.kind in ['visit', 'call', 'message', 'meeting', 'note', 'comment', 'request', 'confirmed', 'declined']
          && (request.resource.data.kind != 'confirmed' || admin(orgId))
          && (request.resource.data.kind != 'declined' || admin(orgId))
          && (admin(orgId) || hasRole(orgId, ['staff']) || leadData().ownerId == request.auth.uid);
        allow delete: if admin(orgId);
      }
    }

    match /orgs/{orgId}/invoices/{invoiceId} {
      allow read: if partnerOf(orgId, resource.data.distributorId);
      allow create: if hasRole(orgId, ['super_admin', 'admin', 'finance_manager'])
        && request.resource.data.amountPaid == 0;
      allow update: if hasRole(orgId, ['super_admin', 'admin', 'finance_manager'])
        && request.resource.data.total >= resource.data.amountPaid;
      allow delete: if immutable();
    }

    /* Credit notes: a price adjustment on an unpaid invoice. Never edited or
       deleted; a mistake is corrected by a further note. */
    match /orgs/{orgId}/creditNotes/{noteId} {
      allow read: if partnerOf(orgId, resource.data.distributorId);
      allow create: if hasRole(orgId, ['super_admin', 'admin', 'finance_manager'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.total > 0;
      allow update, delete: if immutable();
    }

    /* Append-only, like the stock ledger. */
    match /orgs/{orgId}/payments/{paymentId} {
      allow read: if partnerOf(orgId, resource.data.distributorId);
      allow create: if hasRole(orgId, ['super_admin', 'admin', 'finance_manager'])
        && request.resource.data.recordedBy == request.auth.uid
        && request.resource.data.amount > 0;
      allow update, delete: if immutable();
    }

    match /orgs/{orgId}/returns/{returnId} {
      allow read: if partnerOf(orgId, resource.data.distributorId);
      allow create: if member(orgId)
        && mayUseAccount(request.resource.data.distributorId)
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'requested'
        && request.resource.data.quantity > 0;
      allow update: if hasRole(orgId, [
          'super_admin', 'admin', 'staff', 'warehouse_manager', 'operations_manager', 'finance_manager'
        ])
        || (
          resource.data.status == 'requested'
          && resource.data.requestedBy == request.auth.uid
          && request.resource.data.status == 'requested'
          && request.resource.data.distributorId == resource.data.distributorId
        );
      allow delete: if immutable();
    }

    /* A partner sees its own target and its accounts'. */
    match /orgs/{orgId}/targets/{targetId} {
      allow read: if isPartnerRole(orgId)
        && (resource.data.ownerId == request.auth.uid || resource.data.ownerId in accounts());
      allow write: if admin(orgId);
    }

    /* HR */
    /*
     * Salaries, clock in and out, holidays, reissues, bonuses and deductions,
     * and running costs, per organisation (see src/lib/hr.ts).
     *
     * In its own subtree, hr/{orgId}, NOT under orgs/{orgId}: every insider
     * reads everything under orgs/{orgId}, and a colleague's salary is not for
     * everyone. HR managers (super admin, admin, finance manager) see it all;
     * everyone else on the payroll sees only their own record, days and
     * bonuses. Refused entirely when the platform owner has locked HR for the
     * organisation.
     *
     * A clock in is only for TODAY in Lagos (UTC+1), stamped with the server's
     * time, and a clock out only once, also server stamped.
     */
    function featureOn(orgId, feature) {
      return !(feature in get(/databases/$(database)/documents/orgs/$(orgId)).data.get('locked', []));
    }

    function hrManager(orgId) {
      return hasRole(orgId, ['super_admin', 'admin', 'finance_manager']) && featureOn(orgId, 'hr');
    }

    /*
     * Runs people, not money: the HR managers above plus the `hr` role.
     *
     * An HR officer handles attendance, reissues, leave and the holiday list.
     * Salaries, bonuses, running costs and the salary-day settings stay with
     * the managers: every write to those is still `hrManager` only.
     *
     * The one thing an officer can read that touches pay is `hrStaff`, because
     * that is where each person's resumption date lives, and both attendance
     * and the one-year leave rule need it. Rules grant documents, not fields,
     * so an officer reading that record also reads the salary on it. If that
     * matters for a given organisation, the fix is to move `salary` into its
     * own document; nothing else here would change.
     */
    function hrOfficer(orgId) {
      return hasRole(orgId, ['super_admin', 'admin', 'finance_manager', 'hr']) && featureOn(orgId, 'hr');
    }

    /* On the payroll: everyone inside the organisation except distributors. */
    function hrMember(orgId) {
      return hasRole(orgId, [
        'super_admin', 'admin', 'staff', 'sales_rep', 'warehouse_manager', 'finance_manager', 'operations_manager', 'hr'
      ]) && featureOn(orgId, 'hr');
    }

    function lagosDay() {
      let t = request.time + duration.value(1, 'h');
      return t.year() * 10000 + t.month() * 100 + t.day();
    }

    function isoDateOrEmpty(value) {
      return value is string && (value == '' || value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    match /hr/{orgId}/hrSettings/{id} {
      allow read: if hrMember(orgId);
      allow write: if hrManager(orgId)
        && request.resource.data.keys().hasOnly(['payDay', 'cycleStart', 'overrides', 'autoUntil', 'saturday'])
        && request.resource.data.payDay is int
        && request.resource.data.payDay >= 1 && request.resource.data.payDay <= 31
        && request.resource.data.cycleStart is int
        && request.resource.data.cycleStart >= 1 && request.resource.data.cycleStart <= 28
        && request.resource.data.overrides is map
        && isoDateOrEmpty(request.resource.data.autoUntil)
        && request.resource.data.saturday is bool;
    }

    match /hr/{orgId}/hrHolidays/{date} {
      allow read: if hrMember(orgId);
      allow write: if hrOfficer(orgId);
    }

    match /hr/{orgId}/hrStaff/{uid} {
      allow read: if hrOfficer(orgId) || (hrMember(orgId) && uid == request.auth.uid);
      allow write: if hrManager(orgId)
        && request.resource.data.salary is int && request.resource.data.salary >= 0;
      allow delete: if hrManager(orgId);
    }

    match /hr/{orgId}/hrReissues/{id} {
      allow read: if hrOfficer(orgId) || (
        hrMember(orgId) && (id.matches(request.auth.uid + '_[0-9]{8}') || resource.data.uid == request.auth.uid)
      );

      allow create, update: if hrMember(orgId)
        && request.resource.data.uid == request.auth.uid
        && id == request.auth.uid + '_' + string(request.resource.data.day)
        && request.resource.data.keys().hasOnly(['uid', 'name', 'day', 'reason', 'status', 'createdAt'])
        && request.resource.data.day is int
        && request.resource.data.day < lagosDay()
        && request.resource.data.status == 'pending'
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 300
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && (resource == null || resource.data.status == 'declined');

      allow update: if hrOfficer(orgId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt'])
        && request.resource.data.status in ['approved', 'declined'];

      allow delete: if hrOfficer(orgId);
    }

    match /hr/{orgId}/hrAttendance/{id} {
      /* The id check lets someone read their own day before it exists ("not clocked in yet"). */
      allow read: if hrOfficer(orgId) || (
        hrMember(orgId) && (id.matches(request.auth.uid + '_[0-9]{8}') || resource.data.uid == request.auth.uid)
      );

      allow create: if (
          hrOfficer(orgId)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'day', 'manual', 'inAt', 'outAt', 'edited', 'reissue', 'absent', 'leave'])
          && request.resource.data.day is int
          && id == request.resource.data.uid + '_' + string(request.resource.data.day)
        )
        || (
          hrMember(orgId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'day', 'inAt', 'manual'])
          && request.resource.data.day == lagosDay()
          && id == request.auth.uid + '_' + string(request.resource.data.day)
          && request.resource.data.inAt == request.time
          && request.resource.data.manual == false
          && request.resource.data.name is string && request.resource.data.name.size() <= 100
        );

      allow update: if (
          hrOfficer(orgId)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'day', 'manual', 'inAt', 'outAt', 'edited', 'reissue', 'absent', 'leave'])
        )
        || (
          hrMember(orgId)
          && resource.data.uid == request.auth.uid
          && !('outAt' in resource.data)
          && !resource.data.get('absent', false)
          && resource.data.day == lagosDay()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['outAt'])
          && request.resource.data.outAt == request.time
        );

      allow delete: if hrOfficer(orgId);
    }

    /*
     * Leave (see src/lib/leave.ts).
     *
     * Annual leave: ten working days a calendar year, and only once a person
     * has been in the company a full year. Somebody asks for their own; an HR
     * officer approves, declines, or records leave on someone's behalf.
     *
     * The year rule is checked here, not only in the app, against the
     * resumption date on the person's own HR record: the request's first day
     * must be on or after the first anniversary of it. Day numbers are
     * yyyymmdd, so an anniversary is the resumption plus 10000.
     *
     * The ten-day ceiling per request is checked here too. The ceiling per
     * YEAR is the app's job and the officer's: rules cannot sum a collection,
     * and the approval is where a person who has already used their days is
     * caught.
     */
    function resumedDay(orgId, uid) {
      let r = get(/databases/$(database)/documents/hr/$(orgId)/hrStaff/$(uid)).data.get('resumption', '');
      return r is string && r.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') ? int(r.replace('-', '')) : 99999999;
    }

    function leaveShape(d) {
      return d.keys().hasOnly(['uid', 'name', 'from', 'to', 'days', 'year', 'reason', 'status', 'createdAt', 'decidedAt', 'decidedBy', 'byHr'])
        && d.from is int && d.to is int && d.from <= d.to
        && d.days is int && d.days >= 1 && d.days <= 10
        && d.year is int && d.year == int(d.from / 10000) && d.year == int(d.to / 10000)
        && d.reason is string && d.reason.size() <= 300
        && d.name is string && d.name.size() <= 100;
    }

    match /hr/{orgId}/hrLeave/{id} {
      allow read: if hrOfficer(orgId) || (hrMember(orgId) && resource.data.uid == request.auth.uid);

      /* Your own request: pending, in the future, and a year after you resumed. */
      allow create: if hrMember(orgId)
        && leaveShape(request.resource.data)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.from > lagosDay()
        && request.resource.data.from >= resumedDay(orgId, request.auth.uid) + 10000;

      /* An HR officer recording leave for someone, or deciding a request. */
      /* Nobody with only the HR officer role signs off their own leave: a manager does. */
      allow create: if hrOfficer(orgId)
        && leaveShape(request.resource.data)
        && request.resource.data.status in ['pending', 'approved']
        && (request.resource.data.uid != request.auth.uid || hrManager(orgId));
      /* Decided once: only a pending request can be approved or declined. */
      allow update: if hrOfficer(orgId)
        && resource.data.status == 'pending'
        && (resource.data.uid != request.auth.uid || hrManager(orgId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'decidedBy', 'days'])
        && request.resource.data.days is int && request.resource.data.days >= 1 && request.resource.data.days <= 10
        && request.resource.data.status in ['approved', 'declined'];

      /* Withdraw your own while it is still pending. */
      allow delete: if (hrOfficer(orgId) && (resource.data.uid != request.auth.uid || hrManager(orgId)))
        || (hrMember(orgId) && resource.data.uid == request.auth.uid && resource.data.status == 'pending');
    }

    /* Bonuses and deductions: HR writes them; each person reads their own. */
    match /hr/{orgId}/hrAdjustments/{id} {
      allow read: if hrManager(orgId) || (hrMember(orgId) && resource.data.uid == request.auth.uid);
      allow create: if hrManager(orgId)
        && request.resource.data.kind in ['bonus', 'deduction']
        && request.resource.data.amount is int && request.resource.data.amount >= 0
        && request.resource.data.month is string && request.resource.data.month.matches('^[0-9]{4}-[0-9]{2}$');
      allow update, delete: if hrManager(orgId);
    }

    /* Running costs: HR only. */
    match /hr/{orgId}/hrCosts/{id} {
      allow read, write: if hrManager(orgId);
    }

    /* Costing */
    /*
     * Landed cost sheets (see src/lib/costing.ts). In their own subtree,
     * costing/{orgId}, NOT under orgs/{orgId}: insiders read everything there,
     * and what a unit cost to land is for the super admin and admins only.
     */
    match /costing/{orgId}/sheets/{sheetId} {
      allow read, write: if admin(orgId);
    }

    /* The import calculator's saved rates and quotes: one private doc per person. */
    match /costing/{orgId}/quick/{uid} {
      allow read, write: if admin(orgId) && request.auth.uid == uid;
    }

    /* Deny everything else, on purpose. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
