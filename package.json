{
  "name": "afterbi",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "AfterBI \u2014 multi-tenant distribution management for Nigerian FMCG.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "bootstrap": "node scripts/bootstrap-org.mjs",
    "migrate": "node scripts/migrate-to-tenants.mjs",
    "test": "npm run test:policy && npm run test:wiring && npm run test:indexes && npm run test:migrate && npm run test:migrate:smoke && npm run test:bootstrap",
    "test:policy": "esbuild tests/amend.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/amend.mjs --log-level=error --alias:@=./src && node node_modules/.tmp/amend.mjs",
    "test:wiring": "node tests/wiring.test.mjs",
    "test:indexes": "node tests/indexes.test.mjs",
    "test:migrate": "node tests/migrate.test.mjs",
    "test:migrate:smoke": "node tests/migrate-smoke.test.mjs",
    "test:bootstrap": "node tests/bootstrap.test.mjs",
    "test:render": "node sweep.mjs",
    "test:flows": "node flows.mjs",
    "preview:mock": "vite build --config vite.preview.config.ts && vite preview --config vite.preview.config.ts"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "lucide-react": "^1.34.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "esbuild": "^0.28.2",
    "firebase-admin": "^13.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.0"
  }
}
